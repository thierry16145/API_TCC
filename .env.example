# Servidor HTTP
PORT=3000
NODE_ENV=development

# Segredo longo e aleatório para assinar tokens JWT (troque este valor)
JWT_SECRET=troque_por_um_segredo_aleatorio_com_mais_de_32_caracteres
JWT_EXPIRES_IN=8h

# Conexão local com MySQL/MariaDB (XAMPP geralmente usa root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=monitoramento_jornada
DB_CONNECTION_LIMIT=10

# Para desenvolvimento, * permite chamadas de qualquer origem.
# Em produção, troque pela origem específica do seu cliente web.
CORS_ORIGIN=*
